# App
DEBUG=false
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://cordia:password@localhost:5432/cordia_db

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Twilio — Account
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...           # needed for webhook signature validation

# Twilio — API Key (preferred for client auth — generate in Twilio Console > API Keys)
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...

# Twilio — Phone Numbers
TWILIO_PHONE_NUMBER=+1...           # the number Twilio sends FROM
CORDIA_PHONE_NUMBER=+1...           # Cordia's personal cell (for webhook allowlist)
CORDIA_TEST_PHONE_NUMBER=+1...      # test number treated as Cordia during testcordia phase

# Amadeus
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
AMADEUS_ENVIRONMENT=test

# Feature Flags
ENABLE_FLIGHT_SEARCH=true
ENABLE_LEASE_REVIEW=true
ENABLE_FAMILY_COORDINATION=true

# Scheduler
FLIGHT_MONITOR_INTERVAL_MINUTES=60
