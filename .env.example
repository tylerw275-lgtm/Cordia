# App
DEBUG=false
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://cordia:password@localhost:5432/cordia_db

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
CORDIA_PHONE_NUMBER=+1...

# Amadeus
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
AMADEUS_ENVIRONMENT=test

# Feature Flags
ENABLE_FLIGHT_SEARCH=true
ENABLE_LEASE_REVIEW=true
ENABLE_FAMILY_COORDINATION=true

# Scheduler
FLIGHT_MONITOR_INTERVAL_MINUTES=60
