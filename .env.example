# App
DEBUG=false
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://cordia:password@localhost:5432/cordia_db

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# SMS provider: "signalhouse" (the live one — the 10DLC campaign and number are
# there) or "twilio". Everything above the send/receive layer is provider-neutral.
SMS_PROVIDER=signalhouse

# Signal House
SIGNALHOUSE_API_KEY=
SIGNALHOUSE_PHONE_NUMBER=+1...      # the number Cord sends FROM
SIGNALHOUSE_WEBHOOK_SECRET=         # shared secret on /webhook/signalhouse

# Principals — the people who each get their own full assistant, as JSON.
# NOT in the repo: real names, mobile numbers and addresses.
# [{"name": "...", "phone": "+1...", "email": "...", "is_owner": true}]
PRINCIPALS_JSON=

# Operator alerts — feature requests and failures are emailed here.
OPERATOR_EMAIL=tyler@ai-genpartners.com

# Twilio — Account (only used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...           # needed for webhook signature validation

# Twilio — API Key (preferred for client auth — generate in Twilio Console > API Keys)
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...

# Twilio — Phone Numbers
TWILIO_PHONE_NUMBER=+1...           # the number Twilio sends FROM
CORDIA_PHONE_NUMBER=+1...           # Cordia's personal cell (for webhook allowlist)
CORDIA_TEST_PHONE_NUMBER=+1...      # test number treated as Cordia during testcordia phase

# Flights (Duffel — replaces Amadeus)
DUFFEL_ACCESS_TOKEN=duffel_test_...

# Email (dedicated assistant identity — independent of Crown Bakeries)
ENABLE_EMAIL=true
EMAIL_PROVIDER=gmail                 # "gmail" (free, SMTP+IMAP) or "resend"
EMAIL_FROM_NAME=Cordia
OWNER_EMAIL=...                      # Cordia's destination inbox

# Gmail provider (free): a dedicated Gmail + an App Password (turn on 2FA first)
EMAIL_ADDRESS=cordiaassistant@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx  # 16-char Gmail App Password (not the login password)
EMAIL_POLL_INTERVAL_SECONDS=120

# Resend provider (branded domain). Set EMAIL_PROVIDER=resend to use it.
EMAIL_API_KEY=
EMAIL_FROM=

# REQUIRED for two-way email on Resend. Gmail has no free inbound webhook so it
# polls the mailbox instead; Resend pushes to /webhook/email, and that endpoint
# fails closed — with neither secret below set it refuses EVERY inbound message
# with a 403, while outbound keeps working. That reads as "it emails me but
# never replies to me", with nothing in the logs unless you go looking.
#
# Copy the signing secret (whsec_...) from the Resend dashboard's webhook
# settings. Preferred over EMAIL_INBOUND_SECRET: it proves the request came from
# Resend and was not altered in transit.
EMAIL_WEBHOOK_SIGNING_SECRET=
# Fallback only, if the provider cannot sign: a shared secret passed as
# ?secret=... on the webhook URL.
EMAIL_INBOUND_SECRET=

# Family roster, as JSON. NOT in the repo — it holds names, children's dates of
# birth, phone numbers and home addresses. Paste the document into this variable
# in Railway. Unset is safe once the database is seeded; see docs/OVERVIEW.md.
FAMILY_SEED_JSON=
# FAMILY_SEED_PATH=family_seed.local.json   # local development alternative

# Admin API (gates /api/v1/*, /health/config, /health/data).
# Required — these routes expose family PII and conversation history, and are
# denied outright when this is unset.
ADMIN_API_SECRET=

# Feature Flags
SEED_FAMILY_ON_STARTUP=true          # load the family roster on boot (idempotent)
ENABLE_FLIGHT_SEARCH=true
ENABLE_LEASE_REVIEW=true
ENABLE_FAMILY_COORDINATION=true

# Scheduler
SCHEDULER_TIMEZONE=America/Chicago   # cron hours below are in THIS zone
FLIGHT_MONITOR_INTERVAL_MINUTES=60
MORNING_BRIEF_HOUR=7
